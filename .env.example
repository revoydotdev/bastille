# Copy to .env. Values here are the deployed defaults, not the code defaults.

# Keep the database off the root filesystem: the daily snapshot writes ~29 MB a
# day and root runs close to full. /scratch is ext4 on NVMe.
BASTILLE_DB=/scratch/bastille/bastille.db

# Snapshot days kept on disk. ~29 MB/day, so 90 days is ~2.6 GB steady state.
# Set to 0 to keep every day forever.
BASTILLE_SNAPSHOT_RETENTION_DAYS=90

# PORT=5175
# HOST=127.0.0.1
