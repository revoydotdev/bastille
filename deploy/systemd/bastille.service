[Unit]
Description=bastille — grocery price watch (API, dashboard, poller, daily snapshot, clearance sweep)
Documentation=https://github.com/revelri/bastille
After=network-online.target
Wants=network-online.target
# The poller, the daily snapshot and the Walmart sweep are all scheduled inside
# this process. If it is not running, none of them run — which is how the
# snapshot corpus went two weeks without an update.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/revelri/Dev/revelri/bastille
EnvironmentFile=-/home/revelri/Dev/revelri/bastille/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/dist/index.js
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The repo is mounted read-only above; the database lives outside it so the
# service never needs write access to home.
ReadWritePaths=/scratch/bastille
TimeoutStopSec=30

[Install]
WantedBy=default.target
